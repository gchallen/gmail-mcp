{
  "name": "gmail-mcp",
  "version": "2026.9.1",
  "description": "Model Context Protocol server for Gmail: search, read, drafts with local-file attachments, send, reply, forward, labels, trash and spam, attachment download.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "./bin/cli.js"
  },
  "files": [
    "bin/**/*",
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "bun src/cli.ts",
    "dev": "bun src/cli.ts",
    "auth": "bun src/cli.ts auth",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": ["mcp", "model-context-protocol", "gmail", "email", "google"],
  "author": "Geoffrey Challen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gchallen/gmail-mcp.git"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "googleapis": "^171.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
